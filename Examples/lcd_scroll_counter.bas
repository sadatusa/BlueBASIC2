10 REM ========================================================
15 REM STATUS: REAL HARDWARE TESTED (VCC = 3.3V)
20 REM CC2541 HWI2C PCF8574 / HD44780 LCD SCROLL & COUNTER
25 REM NOTE: TUNE BLUE CONTRAST POTENTIOMETER FOR 3.3V OPERATION
30 REM TARGET: YwRobot LCM1602 I2C V1 (PCF8574AT @ ADDR 63 / 0x3F)
40 REM ========================================================
50 HWI2C MASTER 100
60 A = 63
70 L = 8
80 PRINT "INITIALIZING HD44780 16X2 LCD..."
90 GOSUB 400
100 PRINT "STARTING SCROLL & COUNTER DEMO (0 TO 100)..."
110 DIM M(32)
120 M = 66, 76, 85, 69, 66, 65, 83, 73, 67, 32, 67, 67, 50, 53, 52, 49, 32, 72, 87, 73, 50, 67, 32, 76, 67, 68, 32, 68, 69, 77, 79, 32
130 FOR C = 0 TO 100
140 REM --- 1. UPDATE SCROLLING MARQUEE ON LINE 1 ---
150 B = 128
152 R = 0
155 GOSUB 800
160 FOR K = 0 TO 15
170 P = (C + K) % 32
180 B = M(P)
182 R = 1
185 GOSUB 800
190 NEXT K
200 REM --- 2. UPDATE COUNTER ON LINE 2 ---
210 GOSUB 600
220 REM --- 3. PRINT PROGRESS TO UART EVERY 10 TICKS ---
230 IF (C % 10) == 0
240 PRINT "COUNT: ", C, " / 100"
250 END
260 REM --- 4. PACING DELAY (~200 MS) ---
270 FOR J = 1 TO 2000
275 NEXT J
280 NEXT C
290 PRINT "========================================"
300 PRINT "DEMO COMPLETE! COUNT REACHED 100."
310 PRINT "========================================"
320 RETURN
400 REM === HD44780 4-BIT INITIALIZATION SUBROUTINE ===
405 REM PULL EN LOW AND RS LOW, TURN BACKLIGHT ON
410 HWI2C WRITE A, L
415 FOR J = 1 TO 500
418 NEXT J
420 REM 1. WAKE UP CONTROLLER (3X 0X30 STROBES: LOW-HIGH-LOW)
422 HWI2C WRITE A, (48 | L), (48 | L | 4), (48 | L)
430 FOR J = 1 TO 500
435 NEXT J
440 HWI2C WRITE A, (48 | L), (48 | L | 4), (48 | L)
445 FOR J = 1 TO 100
448 NEXT J
450 HWI2C WRITE A, (48 | L), (48 | L | 4), (48 | L)
455 FOR J = 1 TO 100
458 NEXT J
460 REM 2. SWITCH INTERFACE TO 4-BIT MODE (0X20: LOW-HIGH-LOW)
465 HWI2C WRITE A, (32 | L), (32 | L | 4), (32 | L)
470 FOR J = 1 TO 100
475 NEXT J
480 REM 3. FUNCTION SET: 4-BIT MODE, 2 LINES, 5X8 FONT (0X28 = 40)
485 B = 40
490 R = 0
495 GOSUB 800
500 REM 4. DISPLAY OFF (0X08 = 8)
505 B = 8
510 R = 0
515 GOSUB 800
520 REM 5. CLEAR DISPLAY (0X01 = 1)
525 B = 1
530 R = 0
535 GOSUB 800
540 FOR J = 1 TO 500
545 NEXT J
550 REM 6. ENTRY MODE SET: INCREMENT CURSOR, NO SHIFT (0X06 = 6)
555 B = 6
560 R = 0
565 GOSUB 800
570 REM 7. DISPLAY ON, CURSOR OFF (0X0C = 12)
575 B = 12
580 R = 0
585 GOSUB 800
590 RETURN
600 REM === SUBROUTINE: UPDATE LINE 2 (COUNTER: XXX/100) ===
602 B = 192
604 R = 0
606 GOSUB 800
608 REM PRINT 'COUNTER: '
610 R = 1
612 B = 67
614 GOSUB 800
616 B = 79
618 GOSUB 800
620 B = 85
622 GOSUB 800
624 B = 78
626 GOSUB 800
628 B = 84
630 GOSUB 800
632 B = 69
634 GOSUB 800
636 B = 82
638 GOSUB 800
640 B = 58
642 GOSUB 800
644 B = 32
646 GOSUB 800
648 REM HUNDREDS DIGIT
650 IF C >= 100
652 B = 48 + (C / 100)
654 ELSE
656 B = 32
658 END
660 R = 1
662 GOSUB 800
664 REM TENS DIGIT
666 IF C >= 10
668 B = 48 + ((C / 10) % 10)
670 ELSE
672 B = 32
674 END
676 R = 1
678 GOSUB 800
680 REM UNITS DIGIT
682 B = 48 + (C % 10)
684 R = 1
686 GOSUB 800
688 REM PRINT '/100'
690 B = 47
692 R = 1
694 GOSUB 800
696 B = 49
698 GOSUB 800
700 B = 48
702 GOSUB 800
704 B = 48
706 GOSUB 800
710 RETURN
800 REM === LCD SEND BYTE B (R=0: COMMAND, R=1: DATA) ===
805 REM 3-PHASE CLOCKED NIBBLES (DATA STABLE -> EN HIGH -> EN LOW)
810 H = B & 240
820 U = (B << 4) & 240
830 E = L | R
840 HWI2C WRITE A, (H | E), (H | E | 4), (H | E), (U | E), (U | E | 4), (U | E)
850 RETURN
